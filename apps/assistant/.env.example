# Copy to .env for local use. Never put real secrets here: the client secret is read by NAME from
# the secret store (locally an env var SECRET_ASSISTANT_CLIENT_SECRET; in Azure, Key Vault).
PORT=3004

# Incoming authentication (mandatory; see packages/auth). This API's audience, for example:
# AUTH_AUDIENCE=api://assistant

# On-behalf-of: how the assistant acts as the user. Locally, run the dev endpoint:
#   npm run -s dev-token -w @genai/auth -- obo-server --port 4000 --audience api://assistant
# In Azure (Entra ID):
#   OBO_TOKEN_ENDPOINT=https://login.microsoftonline.com/<directory-tenant-id>/oauth2/v2.0/token
OBO_TOKEN_ENDPOINT=http://127.0.0.1:4000/oauth2/v2.0/token
OBO_CLIENT_ID=assistant
OBO_CLIENT_SECRET_NAME=assistant-client-secret

# Downstream services and the API each token is requested for
GATEWAY_URL=http://localhost:3000
PROMPTS_URL=http://localhost:3001
RETRIEVAL_URL=http://localhost:3003
GATEWAY_SCOPE=api://gateway/.default
PROMPTS_SCOPE=api://prompt-registry/.default
RETRIEVAL_SCOPE=api://retrieval/.default

# Prompt looked up in the registry (a built-in default is used if it is not published)
PROMPT_NAME=rag-answer
DOWNSTREAM_TIMEOUT_MS=10000
DEFAULT_TOP_K=4

# Guardrails: enforce (default) blocks, quarantines and redacts; monitor is shadow mode (report only)
GUARDRAILS_MODE=enforce
# Kinds redacted from answers: secret, card, iban, email, phone (questions always mask every kind)
GUARDRAILS_OUTPUT_PII=secret,card,iban

# Answer cache: off (default) | shadow (answer freshly, record how often the cache would have been
# right) | serve. An answer is only reused for the same tenant AND the same sources and prompt.
CACHE_MODE=off
CACHE_SIMILARITY=0.92
CACHE_TTL_MS=3600000
CACHE_MAX_ENTRIES_PER_TENANT=500
# Change to drop every cached answer at once (for instance after switching the model)
CACHE_EPOCH=1

# Streaming: characters held back so output checks see a pattern whole before any of it is sent.
# Longer is safer and starts the stream later.
STREAM_HOLDBACK_CHARS=120

