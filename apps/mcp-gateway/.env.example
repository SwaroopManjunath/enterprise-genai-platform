# Copy to .env for local use. Never put real secrets here: the client secret is read by NAME from
# the secret store (locally an env var SECRET_MCP_GATEWAY_CLIENT_SECRET; in Azure, Key Vault).
PORT=3006

# Incoming authentication (mandatory; see packages/auth). This API's audience, for example:
# AUTH_AUDIENCE=api://mcp-gateway

# On-behalf-of: how the gateway presents the calling user's identity to servers registered with
# auth kind "obo". Locally, run the dev endpoint:
#   npm run -s dev-token -w @genai/auth -- obo-server --port 4000 --audience api://mcp-gateway
OBO_TOKEN_ENDPOINT=http://127.0.0.1:4000/oauth2/v2.0/token
OBO_CLIENT_ID=mcp-gateway
OBO_CLIENT_SECRET_NAME=mcp-gateway-client-secret

# Where the gateway may connect. Public https only by default. Hosts listed here may also be
# reached over plain http and when they resolve to private addresses: keep this empty in production.
ALLOWED_HOSTS=

# Limits
UPSTREAM_TIMEOUT_MS=10000
MAX_UPSTREAM_BYTES=1000000
MAX_RESULT_CHARS=8000
MAX_SERVERS_PER_TENANT=20
MAX_TOOLS_PER_SERVER=100
# A definition longer than this cannot be reviewed in full, so the tool is quarantined
MAX_DESCRIPTION_CHARS=500
MAX_SCHEMA_CHARS=10000
# A tool list older than this is re-read before the next call, to catch a changed definition
VERIFY_TTL_MS=60000
RATE_LIMIT_PER_MINUTE=60

# Guardrails: enforce (default) or monitor (shadow mode, report only)
GUARDRAILS_MODE=enforce
GUARDRAILS_OUTPUT_PII=secret,card,iban

# Telemetry (optional). With neither of the first two set, nothing is exported.
# Use a different METRICS_PORT per service when they run on one machine.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# METRICS_PORT=9464
# TELEMETRY_PSEUDONYM_SALT=change-me-per-deployment
