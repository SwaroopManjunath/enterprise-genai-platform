# Copy to .env for local use. Never commit real keys; in Azure they come from Key Vault.
#
# Authentication is mandatory; the service refuses to start without it. Locally:
#   eval "$(npm run -s dev-token -w @genai/auth -- env)"
# In Azure (Entra ID):
# AUTH_ISSUER=https://login.microsoftonline.com/<directory-tenant-id>/v2.0
# AUTH_AUDIENCE=<this API's application (client) id>
# AUTH_JWKS_URL=https://login.microsoftonline.com/<directory-tenant-id>/discovery/v2.0/keys
PORT=3000

# mock (default, echoes) | mock-grounded (deterministic stand-in that cites sources) | azure
LLM_PROVIDER=mock

# Ordered by preference: first is primary, the rest are fallbacks (ideally another region).
# AZURE_OPENAI_DEPLOYMENTS=[{"name":"aoai-westeurope","endpoint":"https://my-weu.openai.azure.com","deployment":"gpt-4o","apiKeySecret":"aoai-weu-key"},{"name":"aoai-swedencentral","endpoint":"https://my-swc.openai.azure.com","deployment":"gpt-4o","apiKeySecret":"aoai-swc-key"}]
# apiKeySecret names a secret resolved at startup (locally from env var SECRET_AOAI_WEU_KEY; in Azure from Key Vault).

UPSTREAM_TIMEOUT_MS=30000
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=200
RETRY_MAX_DELAY_MS=5000

DEFAULT_REQUESTS_PER_MINUTE=60
DEFAULT_DAILY_TOKEN_QUOTA=1000000
