# Copy to .env for local use. Never commit real keys; in Azure these come from Key Vault (Step 6).
PORT=3000

# mock (default, no cloud needed) | azure
LLM_PROVIDER=mock

# Ordered by preference: first is primary, the rest are fallbacks (ideally another region).
# AZURE_OPENAI_DEPLOYMENTS=[{"name":"aoai-westeurope","endpoint":"https://my-weu.openai.azure.com","deployment":"gpt-4o","apiKey":"<key>"},{"name":"aoai-swedencentral","endpoint":"https://my-swc.openai.azure.com","deployment":"gpt-4o","apiKey":"<key>"}]

UPSTREAM_TIMEOUT_MS=30000
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=200
RETRY_MAX_DELAY_MS=5000

DEFAULT_REQUESTS_PER_MINUTE=60
DEFAULT_DAILY_TOKEN_QUOTA=1000000
