# Copy to .env for local use. Never put real secrets here: the client secret is read by NAME from
# the secret store (locally an env var SECRET_AGENTS_CLIENT_SECRET; in Azure, Key Vault).
PORT=3005

# Incoming authentication (mandatory; see packages/auth). This API's audience, for example:
# AUTH_AUDIENCE=api://agents

# On-behalf-of: how the agent acts as the user. Locally, run the dev endpoint:
#   npm run -s dev-token -w @genai/auth -- obo-server --port 4000 --audience api://agents
# In Azure (Entra ID):
#   OBO_TOKEN_ENDPOINT=https://login.microsoftonline.com/<directory-tenant-id>/oauth2/v2.0/token
OBO_TOKEN_ENDPOINT=http://127.0.0.1:4000/oauth2/v2.0/token
OBO_CLIENT_ID=agents-app
OBO_CLIENT_SECRET_NAME=agents-client-secret

# Downstream services and the API each token is requested for
GATEWAY_URL=http://localhost:3000
RETRIEVAL_URL=http://localhost:3003
GATEWAY_SCOPE=api://gateway/.default
RETRIEVAL_SCOPE=api://retrieval/.default

# Optional: the MCP gateway. With it, the agent also gets the tools the gateway allows each user.
# MCP_GATEWAY_URL=http://localhost:3006
# MCP_GATEWAY_SCOPE=api://mcp-gateway/.default

# Limits. A request can lower the step budget but never exceed HARD_MAX_STEPS.
DEFAULT_MAX_STEPS=6
HARD_MAX_STEPS=10
RUN_TIMEOUT_MS=30000
TOOL_TIMEOUT_MS=10000
MODEL_TIMEOUT_MS=20000
MAX_CALLS_PER_STEP=3
# The same call (same tool, same arguments) this many times in one run is treated as a loop
LOOP_REPEAT_LIMIT=3
MAX_TOOL_OUTPUT_CHARS=4000

# send_email only delivers to these domains, even after a person approves
EMAIL_ALLOWED_DOMAINS=acme-bank.example

# Guardrails: enforce (default) or monitor (shadow mode, report only)
GUARDRAILS_MODE=enforce
GUARDRAILS_OUTPUT_PII=secret,card,iban

# Telemetry (optional). With neither of the first two set, nothing is exported.
# Use a different METRICS_PORT per service when they run on one machine.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# METRICS_PORT=9464
# TELEMETRY_PSEUDONYM_SALT=change-me-per-deployment
