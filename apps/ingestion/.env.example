# Copy to .env for local use. Never put real secrets here: the client secret is read by NAME from
# the secret store (locally an env var SECRET_INGESTION_CLIENT_SECRET; in Azure, Key Vault).
PORT=3002

# Incoming authentication (mandatory; see packages/auth). This API's audience, for example:
# AUTH_AUDIENCE=api://ingestion

# Where processed chunks go:
#   memory     (default) chunks stay in this process: uploaded documents are NOT searchable
#   retrieval  chunks are written to the search index, as this service's own identity
INDEX_SINK=memory

# Required when INDEX_SINK=retrieval. This service authenticates as itself (client credentials) and
# holds the `indexer` role. In Azure (Entra ID):
#   TOKEN_ENDPOINT=https://login.microsoftonline.com/<directory-tenant-id>/oauth2/v2.0/token
# RETRIEVAL_URL=http://localhost:3003
# RETRIEVAL_SCOPE=api://retrieval/.default
# TOKEN_ENDPOINT=http://127.0.0.1:4000/oauth2/v2.0/token
# CLIENT_ID=ingestion-app
CLIENT_SECRET_NAME=ingestion-client-secret
INDEX_TIMEOUT_MS=10000

# Queue and retry
POLL_INTERVAL_MS=500
MAX_DELIVERIES=3
VISIBILITY_TIMEOUT_MS=30000
RETRY_BASE_DELAY_MS=1000
RETRY_MAX_DELAY_MS=30000

# Chunking and limits
CHUNK_MAX_CHARS=1000
CHUNK_OVERLAP_CHARS=100
MAX_DOCUMENT_BYTES=200000

# Telemetry (optional). With neither of the first two set, nothing is exported.
# Use a different METRICS_PORT per service when they run on one machine.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# METRICS_PORT=9464
# TELEMETRY_PSEUDONYM_SALT=change-me-per-deployment
