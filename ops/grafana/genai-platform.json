{
  "title": "GenAI platform: SLOs and health",
  "uid": "genai-platform",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "genai",
    "generated"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Assistant availability: budget left (30d)",
      "description": "A question is answered, or refused for a reason, not dropped by a server fault. Objective 99.5%. 100% means none of the budget is spent; below 0 it is overspent.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "1 - (slo:sli_error:ratio_rate30d{slo=\"assistant-availability\"} / 0.005)",
          "legendFormat": "assistant-availability"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Assistant availability: burn rate",
      "description": "Above 1 the budget is used faster than it is granted. The alerts fire at 14.4, 6, 3 and 1, over two windows each.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "slo:sli_error:ratio_rate1h{slo=\"assistant-availability\"} / 0.005",
          "legendFormat": "1h window"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "slo:sli_error:ratio_rate6h{slo=\"assistant-availability\"} / 0.005",
          "legendFormat": "6h window"
